{
	admin off
}

(pocut-backend) {
	reverse_proxy 127.0.0.1:3211 {
		header_up Host pocut.vxu.me
		header_up X-Forwarded-Host pocut.vxu.me
		header_up X-Forwarded-Proto https
		header_up -Forwarded
		header_up -X-OpenCut-Render-Worker
	}
}

pocut.vxu.me {
	tls /etc/caddy/pocut/origin.pem /etc/caddy/pocut/origin.key
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@entry path /
	redir @entry /projects 302
	@hostedRenderWorker {
		path /render-worker
		query hosted=1
	}
	handle @hostedRenderWorker {
		route {
			forward_auth 127.0.0.1:3211 {
				uri /api/local-drive
				header_up Host pocut.vxu.me
				header_up X-Forwarded-Host pocut.vxu.me
				header_up X-Forwarded-Proto https
				header_up X-OpenCut-Account {http.request.uri.query.account}
				header_up -Forwarded
				@anonymous status 401
				handle_response @anonymous {
					respond 404
				}
			}
			import pocut-backend
		}
	}
	@hostTools path /batch-worker /render-worker /transcription-check
	handle @hostTools {
		respond 404
	}
	@media path /api/local-drive/media /api/local-drive/font /api/local-drive/project-thumbnail /api/local-drive/shared-file /api/account-assets/* /api/global-assets/*
	handle @media {
		header Content-Security-Policy "sandbox; default-src 'none'"
		import pocut-backend
	}
	@appApi path /api/health /api/accounts /api/accounts/legitate/start /api/accounts/legitate/callback /api/local-drive /api/editor-session /api/project-fonts /api/shared-library /api/brand-kits /api/batch-edit /api/ai/chat /api/ai/models /api/ai/oauth/status /api/editor-agent/connection /api/editor-agent/respond /api/editor-agent/harness /api/editor-agent/knowledge /api/editor-agent/hyperframes-references /api/editor-agent/owned-projects /api/generative /api/generative/mcp /api/generative/share/* /api/client-review/* /api/audio-production
	handle @appApi {
		import pocut-backend
	}
	@otherApi path /api /api/*
	handle @otherApi {
		respond 404
	}
	handle {
		import pocut-backend
	}
}
